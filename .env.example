APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=event_system
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET="iventpro-media"
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_URL=

# Bulk SMS - Beem Africa
BEEM_SMS_ENABLED=false
BEEM_SMS_API_KEY=
BEEM_SMS_SECRET_KEY=
BEEM_SMS_SENDER_NAME="IventPro"

# INFOBIP WhatsApp & Messaging
INFOBIP_ENABLED=false
INFOBIP_BASE_URL="api.infobip.com"
INFOBIP_API_KEY=
INFOBIP_SENDER="IventPro"
INFOBIP_WHATSAPP_SENDER=
INFOBIP_WHATSAPP_TEMPLATE_LANGUAGE="en_US"
INFOBIP_WHATSAPP_INVITATION_TEMPLATE_EN="invitation_tamplate_en"
INFOBIP_WHATSAPP_INVITATION_TEMPLATE_SW="invitation_tamplate_sw"
INFOBIP_WHATSAPP_CONTRIBUTION_TEMPLATE_EN="contribution_tamplate_01"
INFOBIP_WHATSAPP_CONTRIBUTION_TEMPLATE_SW="contribution_tamplate_sw"
INFOBIP_WHATSAPP_COMMITTEE_WELCOME_TEMPLATE_EN="committee_message_en"
INFOBIP_WHATSAPP_COMMITTEE_WELCOME_TEMPLATE_SW="committee_message_sw"
INFOBIP_WHATSAPP_COMMITTEE_REMINDER_TEMPLATE_EN="committee_reminder_message_en"
INFOBIP_WHATSAPP_COMMITTEE_REMINDER_TEMPLATE_SW="committee_reminder_message_sw"
INFOBIP_WHATSAPP_THANK_PARTICIPATING_TEMPLATE="thank_participating_tamplate"
INFOBIP_WHATSAPP_THANK_CONTRIBUTION_TEMPLATE="thank_contribution_tamplate"

# Brevo Email Configuration
BREVO_API_KEY=
BREVO_SENDER_EMAIL="concierge@iventpro.com"
BREVO_SENDER_NAME="IventPro"

# Flutterwave Payments
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
PAYMENTS_MODE=test

# Automated SMS / Cron Security
AUTO_SMS_CRON_SECRET=

VITE_APP_NAME="${APP_NAME}"
